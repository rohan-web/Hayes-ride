# Use the same long random value in Vercel and the n8n credential.
# Never expose this value in browser-side code.
N8N_API_SECRET=replace-with-a-long-random-secret

# Production webhook used by the website's server-side Hayes proxy.
# Keep this server-only; do not prefix it with NEXT_PUBLIC_.
N8N_HAYES_WEBHOOK_URL=https://your-n8n-host/webhook/hayes-assistant
