# Use the same long random value in Vercel and the n8n credential.
# Never expose this value in browser-side code.
N8N_API_SECRET=replace-with-a-long-random-secret

# Production webhook used by the website's server-side Hayes proxy.
# Keep this server-only; do not prefix it with NEXT_PUBLIC_.
N8N_HAYES_WEBHOOK_URL=https://your-n8n-host/webhook/hayes-assistant

# Retell realtime browser voice demo.
# These values stay server-side and must never use a NEXT_PUBLIC_ prefix.
RETELL_API_KEY=replace-with-your-retell-secret-api-key
RETELL_AGENT_ID=replace-with-your-published-retell-agent-id

# Comma-separated origins that may create a browser voice call.
# Include localhost only while developing locally.
RETELL_ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.com
